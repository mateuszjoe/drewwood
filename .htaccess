# =============================================
#  DREWWOOD — .htaccess (OVH hosting)
# =============================================

# --- Wymuszenie HTTPS ---
RewriteEngine On
RewriteCond %{ENV:HTTPS} !on
RewriteRule (.*) https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- Kompresja GZIP (szybsze ładowanie) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache przeglądarki ---
<IfModule mod_expires.c>
  ExpiresActive On

  # Obrazy — 6 miesięcy
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/svg+xml "access plus 6 months"

  # Video — 6 miesięcy
  ExpiresByType video/mp4 "access plus 6 months"

  # CSS i JS — 1 miesiąc
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # Fonty — 1 rok
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"

  # HTML — 1 dzień
  ExpiresByType text/html "access plus 1 day"
</IfModule>

# --- Nagłówki bezpieczeństwa ---
<IfModule mod_headers.c>
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-Content-Type-Options "nosniff"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  <FilesMatch "\.(jpg|jpeg|png|webp|svg|mp4|css|js|woff2|woff)$">
    Header set Cache-Control "public, max-age=15552000"
  </FilesMatch>
</IfModule>

# --- Typy MIME ---
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType video/mp4 .mp4
  AddType font/woff2 .woff2
</IfModule>

# --- Blokada ukrytych plików ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Strona 404 ---
ErrorDocument 404 /index.html
